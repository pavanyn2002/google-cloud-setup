#!/bin/bash
# Runs on every boot as the VM startup script. Prepares the node for kubeadm:
# kernel settings, containerd, and kubelet/kubeadm/kubectl. It does NOT run
# kubeadm init/join - you do that by hand (see docs/01-infrastructure.md).
#
# This file is a Terraform template: the only Terraform variable is k8s_minor.
# Shell variables are written as $NAME (no braces) so Terraform leaves them alone.
set -euo pipefail

MARKER=/var/lib/k8s-node-prep.done
if [ -f "$MARKER" ]; then
  echo "node-prep: already done"
  exit 0
fi

K8S_MINOR="${k8s_minor}"

# 0. Wait for outbound internet (Cloud NAT can finish a little after the VM boots).
#    If it never comes, exit non-zero: the marker isn't written, so a reboot retries.
for i in $(seq 1 60); do
  if curl -fsS --max-time 5 -o /dev/null https://pkgs.k8s.io; then break; fi
  echo "node-prep: waiting for internet ($i/60)"
  sleep 5
done
curl -fsS --max-time 5 -o /dev/null https://pkgs.k8s.io

# 1. Kernel modules + sysctls Kubernetes networking needs
cat > /etc/modules-load.d/k8s.conf <<MODS
overlay
br_netfilter
MODS
modprobe overlay
modprobe br_netfilter

cat > /etc/sysctl.d/99-k8s.conf <<SYSCTL
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
SYSCTL
sysctl --system

# 2. Swap must be off (GCE images have none; this is a safety net)
swapoff -a

# 3. Container runtime: containerd with the systemd cgroup driver
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y containerd apt-transport-https ca-certificates curl gpg
mkdir -p /etc/containerd
containerd config default > /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
systemctl restart containerd
systemctl enable containerd

# 4. kubeadm, kubelet, kubectl from the official Kubernetes package repo
mkdir -p /etc/apt/keyrings
curl -fsSL "https://pkgs.k8s.io/core:/stable:/$K8S_MINOR/deb/Release.key" \
  | gpg --dearmor --yes -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/$K8S_MINOR/deb/ /" \
  > /etc/apt/sources.list.d/kubernetes.list
apt-get update
apt-get install -y kubelet kubeadm kubectl
apt-mark hold kubelet kubeadm kubectl # upgrades are deliberate, never via apt upgrade
systemctl enable kubelet

# 5. Point crictl (container debugging tool) at containerd
crictl config --set runtime-endpoint=unix:///run/containerd/containerd.sock

touch "$MARKER"
echo "node-prep: done"
